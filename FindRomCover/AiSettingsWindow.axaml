<Window x:Class="FindRomCover.AiSettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Vision Settings"
        Height="640"
        Width="620"
        WindowStartupLocation="CenterScreen"
        Icon="avares://FindRomCover/Assets/images/logo.png"
        ToolTip.Tip="Configure the AI vision model used to pick cover images">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="AI Assist uses a vision-capable model to look at candidate images and pick the best cover for the selected game. Choose OpenRouter, OpenAI, Anthropic, Gemini or GLM (cloud), a local OpenAI-compatible server such as Ollama or LM Studio, or a custom OpenAI/Anthropic-compatible endpoint." />

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <GroupBox Header="AI Vision Assist" Margin="0,0,0,15"
                          ToolTip.Tip="Provider and model configuration">
                    <StackPanel Margin="5">
                        <CheckBox x:Name="ChkAiEnabled" Content="Enable AI-assisted image selection" Margin="0,5"
                                  ToolTip.Tip="When enabled, the AI Pick Best button is available on the Local Files tab" />

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Provider:" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" x:Name="CmbProvider"
                                      SelectionChanged="CmbProvider_SelectionChanged"
                                      ToolTip.Tip="Cloud providers need an API key; Local targets Ollama or LM Studio; custom endpoints need a Base URL and Model" />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Base URL:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtBaseUrl"
                                     PlaceholderText="https://openrouter.ai/api/v1"
                                     LostFocus="TxtBaseUrl_LostFocus"
                                     ToolTip.Tip="OpenAI-compatible API base URL, e.g. https://openrouter.ai/api/v1 or http://localhost:11434/v1" />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="API Key:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtApiKey"
                                     PlaceholderText="Not required for local models or custom endpoints"
                                     ToolTip.Tip="Your provider API key. Stored encrypted in the settings database and never logged." />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*,Auto">
                            <Label Grid.Column="0" Content="Model:" VerticalAlignment="Center" />
                            <AutoCompleteBox Grid.Column="1" x:Name="CmbModel"
                                             FilterMode="Contains"
                                             MinimumPrefixLength="0"
                                             ToolTip.Tip="Vision-capable model name, e.g. google/gemma-4-26b-a4b-it (OpenRouter), claude-sonnet-4-5 (Anthropic), gemini-2.5-flash (Gemini) or qwen2.5vl:7b (Ollama)" />
                            <Button Grid.Column="2" x:Name="BtnTest" Content="Test / Load Models" Margin="5,0,0,0"
                                    Padding="8,2" Click="BtnTest_Click"
                                    ToolTip.Tip="Contact the provider, verify the key and load the available model list" />
                        </Grid>

                        <Grid Margin="0,3" ColumnDefinitions="170,*,Auto">
                            <TextBox Grid.Column="1" x:Name="TxtModelFilter"
                                     PlaceholderText="Filter models..."
                                     TextChanged="TxtModelFilter_TextChanged"
                                     ToolTip.Tip="Type to filter the loaded model list" />
                            <CheckBox Grid.Column="2" x:Name="ChkVisionOnly" Content="Vision-capable only"
                                      Margin="8,0,0,0" VerticalAlignment="Center" IsChecked="True"
                                      IsCheckedChanged="ChkVisionOnly_Changed"
                                      ToolTip.Tip="Hide models that most likely cannot analyze images" />
                        </Grid>

                        <TextBlock x:Name="TxtModelCount" Margin="0,2,0,0" TextWrapping="Wrap" Opacity="0.8" />

                        <TextBlock x:Name="TxtTestStatus" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="#FF0078D7" />

                        <TextBlock Margin="0,5,0,0">
                            <HyperlinkButton Content="Get an OpenRouter API key" Padding="0"
                                             Tag="https://openrouter.ai/keys"
                                             Click="Hyperlink_Click" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Limits &amp; Behavior" Margin="0,0,0,15"
                          ToolTip.Tip="Controls how many images are analyzed and when results are saved">
                    <StackPanel Margin="5">
                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Timeout (seconds):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtTimeout"
                                     PlaceholderText="90"
                                     ToolTip.Tip="How long to wait for the AI provider before giving up (10-300)" />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Max candidates sent:" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtMaxCandidates"
                                     PlaceholderText="6"
                                     ToolTip.Tip="How many top-ranked local images are sent to the model (1-20)" />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Candidate similarity (%):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtCandidateThreshold"
                                     PlaceholderText="70"
                                     ToolTip.Tip="Only local images whose filename similarity is at or above this value are sent to the AI (0-100). Uses the algorithm selected in the main window." />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Image max size (px):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtImageMaxDimension"
                                     PlaceholderText="512"
                                     ToolTip.Tip="Images are downscaled to this maximum dimension before upload (128-2048)" />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Min cover width (px):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtMinCoverWidth"
                                     PlaceholderText="200"
                                     ToolTip.Tip="Downloaded covers narrower than this are rejected as too low resolution (0 disables the check, max 2048)" />
                        </Grid>

                        <Grid Margin="0,5" ColumnDefinitions="170,*">
                            <Label Grid.Column="0" Content="Auto-save threshold (%):" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="TxtAutoSaveThreshold"
                                     PlaceholderText="80"
                                     ToolTip.Tip="Minimum AI confidence required for automatic saving (0-100)" />
                        </Grid>

                        <CheckBox x:Name="ChkAutoSave" Margin="0,5"
                                  Content="Automatically save the AI pick when confidence is above the threshold"
                                  ToolTip.Tip="The AI-selected image is saved and the game is removed from the missing list automatically" />
                        <CheckBox x:Name="ChkAutoRun" Margin="0,5"
                                  Content="Run AI Pick automatically when a game is selected"
                                  ToolTip.Tip="Starts the AI analysis right after the local search finishes" />
                        <CheckBox x:Name="ChkVerifyOnSave" Margin="0,5"
                                  Content="Verify images with AI before renaming or saving"
                                  ToolTip.Tip="When a new image appears in the image folder, ask the AI to confirm it matches the selected game before renaming it" />
                        <CheckBox x:Name="ChkSkipQueried" Margin="0,5"
                                  Content="Skip missing covers already queried in previous sessions"
                                  ToolTip.Tip="Batch Fill will not ask the AI twice for the same missing cover, even across restarts" />
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Button x:Name="BtnClearHistory" Content="Clear query history" Padding="8,2"
                                    Click="BtnClearHistory_Click"
                                    ToolTip.Tip="Forget every missing cover that was already queried" />
                            <TextBlock x:Name="TxtHistoryCount" Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnSave" Content="Save" Width="100" Margin="0,0,10,0" Click="BtnSave_Click"
                    ToolTip.Tip="Save the AI settings" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="100" Click="BtnCancel_Click"
                    ToolTip.Tip="Discard changes and close this window" />
        </StackPanel>
    </Grid>
</Window>
